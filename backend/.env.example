# Puerto de la API
PORT=3001

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL=postgresql://ciphervault:cambia-esta-contrasena@localhost:5433/ciphervault

# Llave AES-256: 32 bytes en hexadecimal (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secreto para firmar los JWT de la API (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Origen permitido por CORS
FRONTEND_URL=http://localhost:3000

# Mismo Client ID que usa NextAuth en el frontend (para verificar el id_token de Google)
GOOGLE_CLIENT_ID=

# Correos que se crean con rol ADMIN, separados por coma
ADMIN_EMAILS=

# Número de proxies delante de la API (0 en local)
TRUST_PROXY=0

# Días antes de marcar una credencial para rotación
ROTATION_DAYS=90
