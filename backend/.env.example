# Puerto de la API
PORT=3001

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL=postgresql://ciphervault:cambia-esta-contrasena@localhost:5433/ciphervault

# Llave AES-256: 32 bytes en hexadecimal (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secreto para firmar los JWT de la API (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Origen permitido por CORS
FRONTEND_URL=http://localhost:3000

# Mismo Client ID que usa NextAuth en el frontend (para verificar el id_token de Google)
GOOGLE_CLIENT_ID=

# Correos que se crean con rol ADMIN, separados por coma
ADMIN_EMAILS=

# Número de proxies delante de la API (0 en local)
TRUST_PROXY=0

# Días antes de marcar una credencial para rotación
ROTATION_DAYS=90

# --- Verificación en dos pasos por correo (Gmail) ---
# SMTP_USER: la cuenta de Gmail que ENVÍA los códigos.
# SMTP_PASS: una "contraseña de aplicación" de 16 caracteres de esa cuenta
#            (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones).
#            NO es tu contraseña normal de Gmail.
# Si se dejan vacías, en desarrollo el código se imprime en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MFA_CODE_MINUTES=10
# SOLO para correr pentest/pentest.sh y Postman: la API devuelve el código en la respuesta.
# Nunca lo actives fuera del entorno de pruebas (la API no arranca si NODE_ENV=production).
MFA_DEV_EXPOSE_CODE=false
